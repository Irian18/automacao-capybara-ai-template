# Configuração de ambiente — copie para .env e preencha com seus valores

# Self Healing / IA
AI_API_KEY=sua-chave-aqui
BASE_URL=https://api.moonshot.ai/v1
MODEL=kimi-k2.6
PO_MODEL=moonshot-v1-128k

# RAG (Retrieval-Augmented Generation)
RAG_EMBEDDING_MODEL=text-embedding-3-small
RAG_EMBEDDING_API_KEY=sua-chave-aqui
RAG_EMBEDDING_BASE_URL=https://api.moonshot.ai/v1

# Obs.: RAG_ENABLED, RAG_TOP_K e RAG_MIN_SIMILARITY ficam no cucumber.yml
