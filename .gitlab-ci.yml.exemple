# Exemplo de pipeline GitLab CI/CD para automação E2E
# Adapte as variáveis, buckets S3 e IDs de CloudFront da sua infraestrutura.

.install_dependencies: &install_dependencies
  - apt-get update && apt-get upgrade --assume-yes
  - apt-get install gconf-service libasound2 libatk1.0-0 libc6 libcairo2 libcups2 libdbus-1-3 libexpat1 libfontconfig1 libgcc1 libgconf-2-4 libgdk-pixbuf2.0-0 libglib2.0-0 libgtk-3-0 libnspr4 libpango-1.0-0 libpangocairo-1.0-0 libstdc++6 libx11-6 libx11-xcb1 libxcb1 libxcomposite1 libxcursor1 libxdamage1 libxext6 libxfixes3 libxi6 libxrandr2 libxrender1 libxss1 libxtst6 ca-certificates fonts-liberation libnss3 lsb-release xdg-utils --assume-yes
  - apt-get install locales --assume-yes
  - echo "pt_BR.UTF-8 UTF-8" >> /etc/locale.gen
  - locale-gen
  - export LANG=pt_BR.UTF-8
  - export LANGUAGE=pt_BR:pt:en
  - export LC_ALL=pt_BR.UTF-8

.install_firefox_geckodriver: &install_firefox_geckodriver
  - wget -nv -O ~/FirefoxSetup.tar.xz "https://download.mozilla.org/?product=firefox-latest&os=linux64&lang=pt-BR"
  - tar xf ~/FirefoxSetup.tar.xz -C /opt/
  - ln -s /opt/firefox/firefox /usr/bin/firefox
  - export PATH=$PATH:/opt/firefox/
  - wget -nv -O ~/geckodriver.tar.gz "https://github.com/mozilla/geckodriver/releases/download/v0.35.0/geckodriver-v0.35.0-linux64.tar.gz"
  - tar -zxvf ~/geckodriver.tar.gz -C /opt/
  - export PATH=$PATH:/opt/

.install_chrome_for_testing: &install_chrome_for_testing
  - wget -nv https://storage.googleapis.com/chrome-for-testing-public/135.0.7049.114/linux64/chrome-linux64.zip -O /tmp/chrome.zip
  - unzip /tmp/chrome.zip -d /opt/
  - ln -s /opt/chrome-linux64/chrome /usr/bin/google-chrome
  - wget -nv https://storage.googleapis.com/chrome-for-testing-public/135.0.7049.114/linux64/chromedriver-linux64.zip -O /tmp/chromedriver.zip
  - unzip /tmp/chromedriver.zip -d /opt/
  - ln -s /opt/chromedriver-linux64/chromedriver /usr/bin/chromedriver
  - export PATH=$PATH:/opt/chrome-linux64:/opt/chromedriver-linux64

.install_browser_driver: &install_browser_driver
  - *install_dependencies
  - *install_firefox_geckodriver
  - *install_chrome_for_testing

variables:
  LANG: pt_BR.UTF-8
  LC_ALL: pt_BR.UTF-8

stages:
  - download_history
  - test
  - generate_allure_html
  - deploy_report
  - verify_results

download_history:
  stage: download_history
  image: python:3.9-slim
  before_script:
    - pip install awscli
  script:
    - aws s3 sync s3://${S3_HISTORY_BUCKET} report/allure_results/history || true
  artifacts:
    untracked: true
    when: always
    paths:
      - report/
    expire_in: 1 week
  rules:
    - if: '$EXECUTION_TYPE == "" || $EXECUTION_TYPE == "full"'
    - if: '$CI_COMMIT_BRANCH == "main"'

test:
  stage: test
  image: ruby:3.3.5
  variables:
    CUCUMBER_TAGS: "not @wip"
    ENVIRONMENT: "ci"
    RETRY: "2"
  before_script:
    - gem install bundler --no-document
    - bundle config set path 'vendor'
    - bundle install --jobs $(nproc)
    - *install_browser_driver
    - apt-get install -y ffmpeg
    - rm -rf report/html_report
    - mkdir -p report/html_report
    - touch report/html_report/report.html
  script:
    - TAGS_OPTION="${CUCUMBER_TAGS:-\"not @wip\"}"
    - bundle exec cucumber ENVIRONMENT_TYPE=$ENVIRONMENT --format progress --format AllureCucumber::CucumberFormatter --out report/allure_results --retry $RETRY -t "$TAGS_OPTION" || true
    - bundle exec allure generate -c report/allure_results -o report/allure_report_html || true
  cache:
    paths:
      - apt-cache/
      - vendor/ruby
    policy: pull
  artifacts:
    untracked: true
    when: always
    paths:
      - report/
    expire_in: 1 week
  rules:
    - if: '$CI_COMMIT_BRANCH == "main"'

generate_allure_html:
  stage: generate_allure_html
  image: node:20.19
  before_script:
    - npm install -g allure-commandline
    - apt-get update && apt-get upgrade --assume-yes
    - apt-get install default-jre --assume-yes
  script:
    - allure generate -c report/allure_results -o report/allure_report_html
  artifacts:
    untracked: true
    when: always
    paths:
      - report/
    expire_in: 1 week
  rules:
    - if: '$EXECUTION_TYPE == "" || $EXECUTION_TYPE == "full"'
    - if: '$CI_COMMIT_BRANCH == "main"'

deploy_report:
  stage: deploy_report
  image: python:3.9-slim
  before_script:
    - pip install awscli
  script:
    - aws s3 sync report/allure_report_html/history s3://${S3_HISTORY_BUCKET} --delete
    - aws s3 sync report/allure_report_html s3://${S3_REPORT_BUCKET} --delete
    - aws s3 cp s3://${S3_REPORT_BUCKET} s3://${S3_REPORT_BUCKET} --recursive --exclude "*" --include "index.html" --metadata-directive REPLACE --cache-control 'no-cache, no-store, must-revalidate' --acl public-read
    - aws cloudfront create-invalidation --distribution-id ${CLOUDFRONT_DISTRIBUTION_ID} --paths "/" "/*"
  rules:
    - if: '$EXECUTION_TYPE == "" || $EXECUTION_TYPE == "full"'
    - if: '$CI_COMMIT_BRANCH == "main"'

verify_results:
  stage: verify_results
  image: ruby:3.3.5
  before_script:
    - gem install bundler --no-document
    - bundle config set path 'vendor'
    - bundle install --jobs $(nproc)
  script:
    - echo "Adicione aqui a validação da taxa de sucesso"
  rules:
    - if: '$EXECUTION_TYPE == "" || $EXECUTION_TYPE == "full"'
    - if: '$CI_COMMIT_BRANCH == "main"'
